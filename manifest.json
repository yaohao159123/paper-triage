{
  "manifest_version": 3,
  "name": "文献分诊 Paper Triage",
  "version": "0.3.0",
  "description": "用 TypeSafe Jev 判断文献和推文值不值得读：关注 / 普通 / 跳过，跳过的整条变灰（Google Scholar、arXiv、PubMed、X/Twitter）。",
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": ["https://api.typesafe.ai/*"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": { "default_popup": "src/popup/popup.html", "default_title": "文献分诊" },
  "options_ui": { "page": "src/options/options.html", "open_in_tab": true },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": [
        "https://scholar.google.com/*",
        "https://scholar.google.fi/*",
        "https://scholar.google.co.uk/*",
        "https://scholar.google.de/*",
        "https://scholar.google.com.hk/*",
        "https://arxiv.org/*",
        "https://pubmed.ncbi.nlm.nih.gov/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.twitter.com/*"
      ],
      "js": ["src/content/loader.js"],
      "css": ["src/content/badge.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/content/*.js", "src/content/adapters/*.js", "src/shared/*.js"],
      "matches": [
        "https://scholar.google.com/*",
        "https://scholar.google.fi/*",
        "https://scholar.google.co.uk/*",
        "https://scholar.google.de/*",
        "https://scholar.google.com.hk/*",
        "https://arxiv.org/*",
        "https://pubmed.ncbi.nlm.nih.gov/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.twitter.com/*"
      ]
    }
  ]
}
